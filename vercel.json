{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/hotel-api/(live|health|session|state|visit|revision|manager-sessions)/?$",
      "dest": "https://origin-hotel1-1.onrender.com/hotel-api/$1/"
    },
    {
      "src": "^/hotel-api/auth/(login|logout|register|google|complete-profile)/?$",
      "dest": "https://origin-hotel1-1.onrender.com/hotel-api/auth/$1/"
    },
    {
      "src": "^/hotel-api/documents/([0-9a-fA-F-]{36})/?$",
      "dest": "https://origin-hotel1-1.onrender.com/hotel-api/documents/$1/"
    },
    {
      "src": "^/hotel-api/documents/?$",
      "dest": "https://origin-hotel1-1.onrender.com/hotel-api/documents/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!api(?:/|$)|hotel-api(?:/|$)).*$",
      "dest": "/index.html"
    }
  ]
}
