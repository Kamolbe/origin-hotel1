rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the authenticated server API accesses hotel snapshots.
    match /originHotel/{document=**} { allow read, write: if false; }
    match /originHotelSnapshots/{document=**} { allow read, write: if false; }
    match /originHotelLoginAttempts/{document=**} { allow read, write: if false; }
  }
}
