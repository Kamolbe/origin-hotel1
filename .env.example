# Google sign-in uses Firebase Authentication.
# Public Firebase web configuration: src/services/googleAuth.ts
# No VITE_GOOGLE_CLIENT_ID is required.

# Server-only Vercel environment variables. NEVER prefix these with VITE_.
# FIREBASE_SERVICE_ACCOUNT={...Firebase Admin SDK service account JSON...}
HOTEL_ADMIN_EMAIL=admin@admin.com
# HOTEL_ADMIN_PASSWORD_HASH=...generated by node scripts/create-cloud-password.mjs...
# HOTEL_SESSION_SECRET=...at least 32 random characters...

# Optional Vite development mode: run Django on 127.0.0.1:8000 first.
# Built React served by Django enables this automatically at runtime.
# VITE_HOTEL_SERVER=django

# Render: set secrets only in the Render Environment panel.
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=...generate privately in the hosting panel...
# DJANGO_ALLOWED_HOSTS=origin-hotel1-1.onrender.com,origin-hotel.vercel.app,strix-user.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://origin-hotel.vercel.app,https://strix-user.vercel.app,https://origin-hotel1-1.onrender.com
# DJANGO_TRUST_PROXY=1
# HOTEL_FRONTEND_URL=https://origin-hotel.vercel.app
# Durable DB: set DATABASE_URL for PostgreSQL OR attach a real Render disk:
# DATABASE_URL=...private PostgreSQL connection URL...
# DJANGO_DB_PATH=/var/data/origin-hotel.sqlite3
# First admin without Render Shell (remove the password after first creation):
# HOTEL_BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
# HOTEL_BOOTSTRAP_ADMIN_PASSWORD=...set privately in Render, at least 12 characters...
