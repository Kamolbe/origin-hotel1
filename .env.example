# Google sign-in uses Firebase Authentication.
# Public Firebase web configuration: src/services/googleAuth.ts
# No VITE_GOOGLE_CLIENT_ID is required.

# Server-only Vercel environment variables. NEVER prefix these with VITE_.
# FIREBASE_SERVICE_ACCOUNT={...Firebase Admin SDK service account JSON...}
HOTEL_ADMIN_EMAIL=admin@admin.com
# HOTEL_ADMIN_PASSWORD_HASH=...generated by node scripts/create-cloud-password.mjs...
# HOTEL_SESSION_SECRET=...at least 32 random characters...
